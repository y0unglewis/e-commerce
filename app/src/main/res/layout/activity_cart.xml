<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gear_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- TV3 tiếp quản layout này để hiện các CartItem thực tế. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Giỏ hàng"
        android:textColor="@color/gear_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Giỏ hàng đang được phát triển.\nHãy quay lại chọn sản phẩm nhé!"
        android:textColor="@color/gear_muted"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckout"
        style="@style/Widget.GearHub.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiếp tục thanh toán" />
</LinearLayout>
