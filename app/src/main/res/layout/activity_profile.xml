<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gear_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- TV3 xây dựng giao diện tài khoản/đơn hàng của tôi tại đây. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tài khoản"
        android:textColor="@color/gear_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="20dp"
        android:background="@drawable/bg_product_icon"
        android:text="Xin chào, người dùng GearHub!\n\nGiao diện hồ sơ sẽ được thành viên 3 hoàn thiện."
        android:textColor="@color/gear_text"
        android:textSize="16sp" />
</LinearLayout>
